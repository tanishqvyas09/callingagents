# LiveKit Credentials (https://cloud.livekit.io/)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Deepgram (STT & TTS)
# Sign up at https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key

# Groq (LLM)
# Sign up at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key
LLM_PROVIDER=groq
# Default Model: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# Vobiz / SIP Trunking Configuration
VOBIZ_SIP_TRUNK_ID=your_sip_trunk_id
OUTBOUND_TRUNK_ID=your_sip_trunk_id  # Usually same as above
VOBIZ_SIP_DOMAIN=your_trunk_id.sip.vobiz.ai
VOBIZ_USERNAME=your_vobiz_username
VOBIZ_PASSWORD=your_vobiz_password
VOBIZ_OUTBOUND_NUMBER=+91XXXXXXXXXX

DEFAULT_TRANSFER_NUMBER=+91XXXXXXXXXX

# Sarvam AI (Indian TTS voices)
# Sign up at https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_VOICE=anushka
SARVAM_LANGUAGE=en-IN

# Optional Configuration
TTS_PROVIDER=deepgram

# Supabase S3-Compatible Storage (for LiveKit Egress → direct recording upload)
# Find in: Supabase Dashboard → Project Settings → Storage → S3 Connection
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_S3_ACCESS_KEY=your_supabase_s3_access_key_id
SUPABASE_S3_SECRET=your_supabase_s3_secret_access_key
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-south-1
